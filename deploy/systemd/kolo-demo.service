# /etc/systemd/system/kolo-demo.service
#
#   systemctl enable --now kolo-demo
#   journalctl -u kolo-demo -f      ← nhật ký ①③✓ của luồng demo nằm ở đây
#
# Trang demo giữ đơn hàng TRONG RAM: mỗi lần restart là mất sạch đơn cũ, và
# trang /don-hang/<id> của khách cũ trả 404. Đó là hành vi đã biết của bản demo
# (xem demo/README.md), không phải lỗi cấu hình.

[Unit]
Description=Kolo Shop demo (demo.bboapp.xyz)
After=network-online.target kolo-pay.service
Wants=network-online.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/demo.bboapp.xyz

# Không đặt NODE_ENV=production: server.ts là TypeScript chạy trực tiếp, không
# qua bước build, và biến này không đổi gì ở phía nó. Cấu hình nằm ở .env.local
# trong WorkingDirectory.
ExecStart=/usr/bin/npm run demo:shop

# LƯU Ý: demo/kolo-shop/server.ts gọi `server.listen(PORT)` nên nó nghe trên MỌI
# interface — không có cờ nào để bắt nó chỉ nghe loopback. Chặn cổng 4100 trong
# tường lửa aaPanel, nếu không http://IP:4100 vào thẳng, bỏ qua https và WAF.

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kolo-demo

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
