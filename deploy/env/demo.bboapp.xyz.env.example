# =============================================================================
# demo.bboapp.xyz — TRANG SHOP DEMO (Node http server, cổng nội bộ 4100)
# =============================================================================
# CHỈ DÙNG KHI TÁCH TRANG DEMO RA THƯ MỤC RIÊNG.
#
# Bố cục mặc định là một thư mục cho cả hai tiến trình, và khi đó khối KOLO_*
# đã nằm sẵn ở cuối pay.bboapp.xyz.env.example — bỏ qua file này.
# Lý do tách và những gì phải tách kèm: deploy/README.md mục 7.
# Chép thành `.env.local` trong thư mục checkout của trang demo
# (ví dụ /www/wwwroot/demo.bboapp.xyz/.env.local).
#
# Vì sao trang demo có checkout RIÊNG chứ không dùng chung thư mục với cổng
# thanh toán: demo/kolo-shop/server.ts nạp `.env.local` ở gốc repo của chính nó.
# Chung thư mục thì tiến trình demo cầm luôn SESSION_SECRET, chuỗi kết nối
# Postgres và Blockfrost key của cổng thanh toán — trong khi nó chỉ cần hai khoá
# dưới đây. Tách ra là để một lỗi ở trang demo không kéo theo cổng nhận tiền.

# --- Địa chỉ hai bên ---------------------------------------------------------
KOLO_SHOP_PORT=4100

# Domain của chính trang demo. Dùng để dựng returnUrl — phải khớp CHÍNH XÁC một
# origin trong MERCHANT_RETURN_URL_ORIGINS bên cổng thanh toán, https và không
# có dấu / ở cuối.
KOLO_SHOP_URL=https://demo.bboapp.xyz

# Cổng thanh toán mà trang demo gọi sang.
KOLO_PAY_URL=https://pay.bboapp.xyz

# --- Mạng --------------------------------------------------------------------
# mainnet = khách bấm mua là trả TIỀN THẬT (4.90 / 49.00 / 9.90 USD trong bảng
# hàng ở demo/kolo-shop/server.ts). Đổi thành `preprod` để trình diễn bằng token
# thử — khi đó cổng thanh toán phải bật cả preprod.
KOLO_SHOP_NETWORK=mainnet

# --- Khoá dùng chung với cổng thanh toán -------------------------------------
# Khoá ĐẦU TIÊN trong MERCHANT_API_KEYS bên pay.bboapp.xyz.
MERCHANT_API_KEYS=

# Phải GIỐNG HỆT MERCHANT_WEBHOOK_SECRET bên pay.bboapp.xyz.
MERCHANT_WEBHOOK_SECRET=

# --- Ngôn ngữ ----------------------------------------------------------------
# Đặt giống bên cổng thanh toán, nếu không khách sẽ thấy shop tiếng Anh bàn giao
# sang trang thanh toán tiếng Việt.
DEFAULT_LOCALE=en
