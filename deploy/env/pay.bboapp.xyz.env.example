# =============================================================================
# pay.bboapp.xyz — CỔNG THANH TOÁN (Next.js, cổng nội bộ 3000)
# =============================================================================
# Chép file này thành `.env.local` ở gốc checkout trên máy app
# (/home/talosmine/Connect-Wallet-Cardano/.env.local) rồi điền giá trị thật.
#
#   chmod 600 .env.local
#
# Cả HAI tiến trình đọc file này: `npm start` (cổng thanh toán, 4000) và
# `npm run demo:shop` (trang demo, 4100).
#
# ĐỪNG chép `.env.local` của máy dev lên đây. Mọi secret bên dưới phải sinh MỚI:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Dùng lại secret của máy dev nghĩa là một lần lộ máy dev kéo theo cả production.

# --- Ngôn ngữ mặc định -------------------------------------------------------
# Đặt GIỐNG bên demo. Cookie `cardano_locale` phân định theo host nên
# demo.bboapp.xyz và pay.bboapp.xyz KHÔNG dùng chung lựa chọn ngôn ngữ nữa —
# biến này là thứ duy nhất giữ hai bên mở ra cùng một thứ tiếng.
DEFAULT_LOCALE=en

# --- Session -----------------------------------------------------------------
# Bắt buộc ở production. Đổi giá trị này = đá mọi phiên đăng nhập hiện có.
SESSION_SECRET=

# --- Hạ tầng -----------------------------------------------------------------
# Khớp với docker-compose.yml của repo: hai container cardano-pay-postgres và
# cardano-pay-redis đang chạy sẵn, cổng phía host là 5442 / 6389 (đặt lệch cổng
# mặc định để không đụng Postgres của dự án khác trên cùng máy).
DATABASE_URL=postgres://cardano:cardano@127.0.0.1:5442/cardano_pay
REDIS_URL=redis://127.0.0.1:6389

# Mật khẩu `cardano/cardano` là mật khẩu dev để trần trong docker-compose.yml, và
# Redis chưa có requirepass. Máy này không có IP công cộng nên hai cổng đó chỉ lộ
# ra LAN — chấp nhận được để chạy thử, phải siết trước khi bật mainnet.
# Xem deploy/README.md mục 7.

# --- Mainnet — TIỀN THẬT -----------------------------------------------------
# Project id phải bắt đầu bằng "mainnet". Key sai mạng bị từ chối ngay lúc
# /health, không âm thầm đối chiếu nhầm chain.
BLOCKFROST_API_KEY_MAINNET=mainnet...

# Địa chỉ NHẬN TIỀN. Phải bắt đầu bằng "addr1" và phải là ví BẠN kiểm soát.
# Không bao giờ đến từ request — ai có khoá API cũng không đổi được nơi tiền chảy về.
MERCHANT_ADDRESS_MAINNET=addr1...

# Bật SAU CÙNG, sau khi /api/payments/health đã xanh. Xem mục 9 của deploy/README.md.
PAYMENT_ENABLED_MAINNET=false

# Metadata NFT (tên, ảnh) cho phần ví. Dùng chung key mainnet ở trên cũng được.
BLOCKFROST_API_KEY=mainnet...

# --- Domain công khai --------------------------------------------------------
# Dùng để dựng link /pay/<mã> trả về cho shop. BẮT BUỘC: app cố tình KHÔNG suy ra
# từ header Host, vì Host là do client gửi.
PAYMENT_PUBLIC_URL=https://pay.bboapp.xyz

# --- Vận hành ----------------------------------------------------------------
# Thiếu watcher secret thì cron trả 401 và KHÔNG đơn nào chuyển sang confirmed.
PAYMENT_WATCHER_SECRET=
PAYMENT_HEALTH_TOKEN=

# Ai xem được sổ đơn hàng ở /orders. Địa chỉ stake MAINNET (stake1...) của ví bạn
# đăng nhập bằng. Để trống = /orders khoá hẳn ở production.
# Lưu ý: stake_test1... trong .env.local dev là địa chỉ preprod, KHÔNG dùng được ở đây.
PAYMENT_ADMIN_ADDRESSES=stake1...

# Số proxy tin cậy đứng TRƯỚC app. Chỉ nginx của aaPanel = 1.
# Thêm Cloudflare (bật đám mây cam) = 2. Đặt sai thì hạn mức theo IP mất tác dụng
# hoặc chặn nhầm — /api/payments/health có nói rõ tình trạng.
TRUSTED_PROXY_HOPS=1

# Số đơn tối đa một IP tạo được trong một giờ (mặc định production: 30).
# PAYMENT_ORDER_RATE_LIMIT=30

# --- Ghép với demo.bboapp.xyz ------------------------------------------------
# Khoá shop dùng để gọi /api/v1/*. Nhiều khoá cách nhau bằng dấu phẩy (để xoay khoá).
# Trang demo lấy khoá ĐẦU TIÊN.
MERCHANT_API_KEYS=

# Nơi báo ngược khi tiền về. Phải là https và phải tới được từ chính VPS này.
MERCHANT_WEBHOOK_URL=https://demo.bboapp.xyz/api/webhooks/kolo-pay

# Khoá ký webhook (≥32 ký tự). Hai bên phải GIỐNG HỆT, lệch một ký tự là 401 hàng loạt.
MERCHANT_WEBHOOK_SECRET=

# Origin được phép xuất hiện trong returnUrl. Khớp CHÍNH XÁC: http vs https,
# subdomain, cổng — sai một thứ là bị từ chối. Đây là chốt chặn open redirect.
MERCHANT_RETURN_URL_ORIGINS=https://demo.bboapp.xyz

# --- Cổng nội bộ -------------------------------------------------------------
# Không có biến nào cho cổng của cổng thanh toán: nó nằm ở cờ `-p 4000` trong
# kolo-pay.service. Ghi lại ở đây cho khỏi phải đi tìm.
#
#   4000  cổng thanh toán   (3000 đã bị container talosmine-web chiếm)
#   4100  trang demo        (3100 đã bị container talosmine-api chiếm)

# =============================================================================
# TRANG DEMO — demo.bboapp.xyz (tiến trình thứ hai, cùng thư mục này)
# =============================================================================
# Khối này nằm chung file vì `npm run demo:shop` chạy từ đúng thư mục này và nạp
# chính `.env.local` này. Nhờ vậy MERCHANT_API_KEYS và MERCHANT_WEBHOOK_SECRET
# chỉ khai một lần — không còn cửa để hai bên lệch khoá.
#
# Tách trang demo ra thư mục riêng thì chuyển khối này sang `.env.local` của
# thư mục đó; xem deploy/env/demo.bboapp.xyz.env.example.

KOLO_SHOP_PORT=4100

# Domain của trang demo. Phải khớp CHÍNH XÁC một origin trong
# MERCHANT_RETURN_URL_ORIGINS ở trên: https, không dấu / ở cuối.
KOLO_SHOP_URL=https://demo.bboapp.xyz

# Cổng thanh toán mà trang demo gọi sang. Để trống thì nó rơi về
# PAYMENT_PUBLIC_URL ở trên — nhưng khai tường minh vẫn hơn.
KOLO_PAY_URL=https://pay.bboapp.xyz

# mainnet = khách bấm mua là trả TIỀN THẬT (4.90 / 49.00 / 9.90 USD theo bảng
# hàng trong demo/kolo-shop/server.ts). Đổi thành `preprod` để trình diễn bằng
# token thử — khi đó cổng thanh toán phải bật thêm preprod, xem mục 10 của
# deploy/README.md.
KOLO_SHOP_NETWORK=mainnet

# =============================================================================
# CỐ Ý KHÔNG CÓ TRÊN MÁY CHỦ NÀY
# =============================================================================
# MINT_MNEMONIC / FAUCET_MNEMONIC — seed ví mint. Không có việc gì để nó nằm trên
#   máy chủ nhận tiền thật. Chỉ giữ ở máy dev khi chạy script mint token preprod.
# FAUCET_ENABLED — faucet chỉ chạy trên preprod và mặc định TẮT ở production.
#   Cứ để trống.
# STABLECOINS_PREPROD — token thử. Stablecoin mainnet (USDM, iUSD, DJED, USDA)
#   đã nằm sẵn trong mã nguồn, không cần khai.
